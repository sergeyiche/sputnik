# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,file://

# --- LLM (провайдер: gigachat | openai — openai для будущей замены) ---
LLM_PROVIDER=gigachat

# GigaChat OAuth (https://developers.sber.ru/docs/ru/gigachat/api/reference/rest/gigachat-api)
# Authorization key из GigaChat Studio — используется для получения access_token
GIGACHAT_AUTHORIZATION_KEY=
# Fallback для совместимости (deprecated): AUTHORIZATION_KEY, GIGACHAT_CREDENTIALS
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL_CERTS=true
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_BASE_URL=https://api.giga.chat/v1
# Сертификат НУЦ Минцифры (скачать: ./scripts/setup-gigachat-certs.sh)
# В Docker путь задаётся в docker-compose.yml автоматически
# GIGACHAT_CA_BUNDLE_FILE=./config/certs/gigachat-ca-bundle.pem
# Chat-модели: GigaChat-2 | GigaChat-2-Pro | GigaChat-2-Max | GigaChat-3-Ultra

# OpenAI-compatible (если LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Embeddings ---
# local — бесплатно, работает offline после первой загрузки модели (рекомендуется для MVP)
# gigachat — через GigaChat Embeddings API (может требовать платный тариф, ошибка 402)
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# --- Vector store ---
# Пути ниже — для Docker (/app/...). Локально: ./scripts/setup-local-env.sh
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION=parkinson_kb

# --- RAG ---
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# --- Session ---
SESSION_COOKIE_NAME=parkinson_session
SESSION_MAX_MESSAGES=20

# --- Knowledge ---
KNOWLEDGE_SOURCES_DIR=/app/data/knowledge_sources
KNOWLEDGE_DIR=/app/data/knowledge

# --- Prompts ---
SYSTEM_PROMPT_PATH=/app/config/system_prompt.md
