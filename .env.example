# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,file://

# --- LLM (провайдер: gigachat | openai — openai для будущей замены) ---
LLM_PROVIDER=gigachat

# GigaChat OAuth (https://developers.sber.ru/docs/ru/gigachat/api/reference/rest/gigachat-api)
# Authorization key из GigaChat Studio — используется для получения access_token
GIGACHAT_AUTHORIZATION_KEY=
# Fallback для совместимости (deprecated): AUTHORIZATION_KEY, GIGACHAT_CREDENTIALS
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL_CERTS=true
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_BASE_URL=https://api.giga.chat/v1
# Сертификат НУЦ Минцифры (скачать: ./scripts/setup-gigachat-certs.sh)
# В Docker путь задаётся в docker-compose.yml автоматически
# GIGACHAT_CA_BUNDLE_FILE=./config/certs/gigachat-ca-bundle.pem
# Chat-модели: GigaChat-2 | GigaChat-2-Pro | GigaChat-2-Max | GigaChat-3-Ultra

# OpenAI-compatible (если LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# --- Embeddings ---
# local — бесплатно, работает offline после первой загрузки модели (рекомендуется для MVP)
# gigachat — через GigaChat Embeddings API (может требовать платный тариф, ошибка 402)
EMBEDDINGS_PROVIDER=local
LOCAL_EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# --- Vector store ---
# Пути ниже — для Docker (/app/...). Локально: ./scripts/setup-local-env.sh
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION=parkinson_kb

# --- RAG ---
RAG_TOP_K=5
# Сколько кандидатов запросить до отбора top_k (diversity + фильтр)
RAG_FETCH_K=10
# Опционально: отсечь слабые чанки (distance; меньше = ближе). Пример: 1.2
# RAG_MAX_DISTANCE=
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# --- Session ---
# Виджет помнит идентификатор в localStorage. Переписка хранится в SQLite без срока давности.
SESSION_COOKIE_NAME=parkinson_session

# --- Admin (/admin/) ---
# Пустой пароль — админка выключена (все /v1/admin/* отвечают 503)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Время жизни сессии админа, минуты
ADMIN_SESSION_TTL_MINUTES=480
# true — cookie только по HTTPS (обязательно в production за TLS)
ADMIN_COOKIE_SECURE=false
# Лимит размера загружаемого файла; nginx пропускает до 60 МБ (apps/widget/nginx.conf)
ADMIN_MAX_UPLOAD_MB=50

# --- Platform ---
PLATFORM_BASE_DOMAIN=spootnik.ru
PLATFORM_DB_PATH=./data/platform/platform.db
DATA_ROOT=./data

# --- Mail ---
# smtp — локальный Mailcatcher (http://localhost:1080). В Docker хост перекрывается на mailcatcher.
# mailtrap — облако: песочница или боевая отправка, https://mailtrap.io/api-tokens
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILTRAP_API_KEY=
MAILTRAP_USE_SANDBOX=true
MAILTRAP_INBOX_ID=
MAILTRAP_SENDER_EMAIL=noreply@spootnik.ru
MAILTRAP_SENDER_NAME=Спутник
# Сколько минут действует ссылка из письма
PASSWORD_RESET_TTL_MINUTES=60

# --- Skills (domain routing; see SKILLS.md) ---
SKILLS_ENABLED=true
SKILLS_SCORE_THRESHOLD=0.42
SKILLS_MAX_ACTIVE=2
SKILLS_SUGGESTION_COUNT=3

# --- Knowledge ---
KNOWLEDGE_SOURCES_DIR=/app/data/knowledge_sources
KNOWLEDGE_DIR=/app/data/knowledge
# Названия источников и правила скачивания исходников (перечитывается при изменении файла)
KNOWLEDGE_SOURCES_MANIFEST=/app/config/knowledge_sources.json

# --- Prompts ---
SYSTEM_PROMPT_PATH=/app/config/default_system_prompt.md
# Версии, сохранённые из админки. Сам файл по умолчанию не перезаписывается.
PROMPT_VERSIONS_DIR=/app/data/prompts
# JSON со стартовыми вопросами-подсказками виджета (перечитывается при изменении файла)
STARTER_QUESTIONS_PATH=/app/config/starter_questions.json
